ClientInsFile 1.0

Server
    EditorName        = 'ProvenMetal'
    EditorExePath     = 'ProvenMetal.DLL'
    EditorDescription = 'Push a project BOM to ProvenMetal Central and flag parts that are not in stock or sourceable within a week.'
    Version           = 'Version 1.0.0.0'
    Date              = '01-Jan-2026'
    HelpAboutInfo     = 'ProvenMetal BOM sourcing for Altium Designer.'
    Copyright         = 'Copyright ProvenMetal'
    Updates           = 'AdvSch'
    SystemExtension   = True
End

Command Name = 'SourceBom'  LongSummary = 'Push the BOM to ProvenMetal Central and show the sourcing verdict.'  End
